{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Packmoat conformance vectors: the token check",
  "description": "See core/spec/README.md. Every object is closed (no other fields) except a NuGet body, which is the upstream's JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "definitions": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "UTC, ending in Z, at most 3 fraction digits"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "now",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        },
        "now": {
          "$ref": "#/definitions/time"
        },
        "note": {
          "type": "string"
        },
        "input": {
          "$ref": "#/definitions/input"
        },
        "expected": {
          "$ref": "#/definitions/expected"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorization"
      ],
      "properties": {
        "authorization": {
          "type": [
            "string",
            "null"
          ]
        },
        "tenants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "active": {
                "type": "boolean"
              },
              "gate": {
                "enum": [
                  "serve",
                  "refuse",
                  "fail"
                ]
              }
            }
          }
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "token",
              "tenant"
            ],
            "properties": {
              "token": {
                "type": "string",
                "minLength": 1
              },
              "tenant": {
                "type": "string"
              },
              "revoked": {
                "type": "boolean"
              },
              "expiresAt": {
                "$ref": "#/definitions/time"
              }
            }
          }
        },
        "store": {
          "enum": [
            "available",
            "unavailable"
          ]
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            200,
            401,
            503
          ]
        },
        "reason": {
          "enum": [
            "authenticated",
            "no_credentials",
            "token_rejected",
            "unavailable"
          ]
        },
        "tenant": {
          "type": "string"
        },
        "challenge": {
          "type": "string"
        }
      }
    }
  }
}
