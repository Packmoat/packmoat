{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Packmoat conformance vectors: service indexes",
  "description": "See core/spec/README.md. Every object is closed (no other fields) except a NuGet body, which is the upstream's JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "definitions": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "UTC, ending in Z, at most 3 fraction digits"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "now",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        },
        "now": {
          "$ref": "#/definitions/time"
        },
        "note": {
          "type": "string"
        },
        "input": {
          "$ref": "#/definitions/input"
        },
        "expected": {
          "$ref": "#/definitions/expected"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upstreamBase",
        "proxyBase",
        "body"
      ],
      "properties": {
        "upstreamBase": {
          "type": "string",
          "pattern": "^https?://.+/$"
        },
        "proxyBase": {
          "type": "string",
          "pattern": "^https?://.+/$"
        },
        "body": {}
      }
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "body"
          ],
          "properties": {
            "status": {
              "enum": [
                200
              ]
            },
            "body": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                502,
                503
              ]
            }
          }
        }
      ]
    },
    "verdictCode": {
      "enum": [
        "cooldown",
        "cooldown_elapsed",
        "waiver",
        "internal_namespace",
        "date_unknown",
        "date_source_unavailable",
        "no_policy_decided",
        "policy_error"
      ]
    }
  }
}
