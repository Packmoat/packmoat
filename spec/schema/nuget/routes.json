{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Packmoat conformance vectors: what an upstream path asks for",
  "description": "See spec/README.md. Every object is closed (no other fields) except a NuGet body, which is the upstream's JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "definitions": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "UTC, ending in Z, at most 3 fraction digits"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "now",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        },
        "now": {
          "$ref": "#/definitions/time"
        },
        "note": {
          "type": "string"
        },
        "input": {
          "$ref": "#/definitions/input"
        },
        "expected": {
          "$ref": "#/definitions/expected"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "service_index",
            "flat_container_versions",
            "flat_container_content",
            "registration_index",
            "registration_page",
            "registration_leaf",
            "catalog_entry",
            "unknown"
          ]
        },
        "packageId": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      }
    }
  }
}
