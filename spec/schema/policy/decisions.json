{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Packmoat conformance vectors: policy decisions",
  "description": "See core/spec/README.md. Every object is closed (no other fields) except a NuGet body, which is the upstream's JSON.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cases"
  ],
  "properties": {
    "description": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/case"
      }
    }
  },
  "definitions": {
    "time": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$",
      "description": "UTC, ending in Z, at most 3 fraction digits"
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "now",
        "input",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^\\S(.*\\S)?$"
        },
        "now": {
          "$ref": "#/definitions/time"
        },
        "note": {
          "type": "string"
        },
        "input": {
          "$ref": "#/definitions/input"
        },
        "expected": {
          "$ref": "#/definitions/expected"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "package",
        "publishDates"
      ],
      "properties": {
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cooldownDays"
          ],
          "properties": {
            "cooldownDays": {
              "type": "integer",
              "minimum": 0
            },
            "internalPrefixes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "waivers": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "packageId",
                  "version",
                  "expiresAt"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "packageId": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  },
                  "expiresAt": {
                    "$ref": "#/definitions/time"
                  }
                }
              }
            },
            "packageOverrides": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "packageId",
                  "cooldownDays"
                ],
                "properties": {
                  "packageId": {
                    "type": "string"
                  },
                  "cooldownDays": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        "package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          }
        },
        "publishDates": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/definitions/time"
          }
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "reason"
      ],
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "hide"
          ]
        },
        "reason": {
          "$ref": "#/definitions/verdictCode"
        },
        "waiverId": {
          "type": "string"
        },
        "cooldownDaysApplied": {
          "type": "integer",
          "minimum": 0
        },
        "publishedAt": {
          "$ref": "#/definitions/time"
        }
      }
    },
    "verdictCode": {
      "enum": [
        "cooldown",
        "cooldown_elapsed",
        "waiver",
        "internal_namespace",
        "date_unknown",
        "date_source_unavailable",
        "no_policy_decided",
        "policy_error"
      ]
    }
  }
}
