# /etc/packmoat/caddy.env: Caddy's settings. Host names and the certificate contact address only. Never the master key or any secret.
# Each host must match the same setting in /etc/packmoat/packmoat.env.
PACKMOAT_HOSTS=packages.contoso.example
ACME_EMAIL=ops@contoso.example
# Only if you run the admin site or the customer site:
# PACKMOAT_ADMIN_HOST=admin.contoso.example
# PACKMOAT_APP_HOST=app.contoso.example
