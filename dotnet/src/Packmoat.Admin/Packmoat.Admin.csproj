<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Packmoat.Application\Packmoat.Application.csproj" />
    <ProjectReference Include="..\Packmoat.Domain\Packmoat.Domain.csproj" />
    <ProjectReference Include="..\Packmoat.Infrastructure\Packmoat.Infrastructure.csproj" />
    <!-- The PostgreSQL adapter: the composition roots (PackmoatApp and AdminCli) pick the engine, so only they reference it. -->
    <ProjectReference Include="..\Packmoat.Infrastructure.Postgres\Packmoat.Infrastructure.Postgres.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <!-- A library: the entry points are the core's Packmoat.Cli and the hosted Packmoat.Hosted.Admin. -->
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
