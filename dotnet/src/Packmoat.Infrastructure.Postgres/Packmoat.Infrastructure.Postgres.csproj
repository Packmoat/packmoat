<Project Sdk="Microsoft.NET.Sdk">

  <!-- The PostgreSQL adapter (#288). No src project references it yet: PACKMOAT_DB_ENGINE=postgres is still refused, so no image ships
       Npgsql. DependencyRuleTests pins both: it references only Domain, Application and Infrastructure, and nothing in src/ references it. -->

  <ItemGroup>
    <ProjectReference Include="..\Packmoat.Domain\Packmoat.Domain.csproj" />
    <ProjectReference Include="..\Packmoat.Application\Packmoat.Application.csproj" />
    <ProjectReference Include="..\Packmoat.Infrastructure\Packmoat.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PostgreSQL licence (permissive, like MIT). A plain version, as everywhere here: NuGet resolves exactly it, and a missing version is
         an error (NU1603 with warnings as errors). Its one dependency on net10.0 is Microsoft.Extensions.Logging.Abstractions. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Packmoat.Infrastructure.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
