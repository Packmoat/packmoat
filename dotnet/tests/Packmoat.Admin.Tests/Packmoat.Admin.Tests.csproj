    <Compile Include="..\Packmoat.Infrastructure.Tests\EngineDb.cs" Link="EngineDb.cs" />
    <Compile Include="..\Packmoat.Infrastructure.Tests\TestCli.cs" Link="TestCli.cs" />
  </ItemGroup>

