<Project>
  <!-- The core's build settings, as every core project has them; MSBuild stops at the first Directory.Build.props it finds. -->
  <Import Project="$(MSBuildThisFileDirectory)../Directory.Build.props" />
  <!-- Every test project here runs under TempLeakGuard. -->
  <Import Project="$(MSBuildThisFileDirectory)Shared/TempLeakGuard.props" />
</Project>
