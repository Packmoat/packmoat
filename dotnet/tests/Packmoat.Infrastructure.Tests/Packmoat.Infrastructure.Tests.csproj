<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Packmoat.Infrastructure\Packmoat.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Packmoat.Infrastructure.Postgres\Packmoat.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="..\..\src\Packmoat.Application\Packmoat.Application.csproj" />
    <ProjectReference Include="..\..\src\Packmoat.Domain\Packmoat.Domain.csproj" />
    <ProjectReference Include="..\..\src\Packmoat.Admin\Packmoat.Admin.csproj" />
    <!-- AddSqliteStores, for the PostgreSQL registration's parity test. -->
    <ProjectReference Include="..\..\src\Packmoat.Host\Packmoat.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The fake Azure Artifacts feed, for the PostgreSQL end-to-end test. -->
    <Compile Include="..\Packmoat.Host.Tests\FakeUpstream.cs" Link="Postgres\FakeUpstream.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Contracts\contract-tests.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
